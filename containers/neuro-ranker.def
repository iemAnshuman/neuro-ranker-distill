Bootstrap: docker
From: nvidia/cuda@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc

%labels
    org.opencontainers.image.title NeuroRanker Distill
    org.opencontainers.image.version 0.2.0
    org.opencontainers.image.source https://github.com/iemAnshuman/neuro-ranker-distill

%files
    . /opt/neuro-ranker

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/python -m pip install --require-hashes \
        -r /opt/neuro-ranker/requirements-runtime.lock
    /opt/venv/bin/python -m pip install --no-build-isolation \
        --no-deps /opt/neuro-ranker

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false

%runscript
    exec /opt/venv/bin/neuro-ranker "$@"

%test
    work_dir=$(mktemp -d)
    /opt/venv/bin/neuro-ranker prepare --config /opt/neuro-ranker/configs/fixture.json \
        --output "$work_dir/fixture"
    /opt/venv/bin/neuro-ranker verify-data --data-dir "$work_dir/fixture"
